{
  // (notes_md) = Tree.cache(
  //   package:@weborigami/dropbox(<dropbox-creds.js>())/notes
  //   files:cache
  // )
  // (notes_data) = Tree.reverse(Tree.sort(Tree.map(notes_md, <md-to-data.js>)))

  version: "https://jsonfeed.org/version/1"
  title: "Jim Nielsen’s Notes"
  home_page_url: "https://notes.jim-nielsen.com"
  feed_url: "https://notes.jim-nielsen.com/feed.json"
  items: <md-to-data.ori>/

  // For use in looking up the IDs of items by domain, e.g.
  // { "youtube.com": ["…", "…", "…"], "twitter.com": ["…"], ... }
  _item_ids_by_domain: Tree.plain(
    Tree.map(
      Tree.groupBy(items, (item) => item._external_url_domain),
      (items, domain) => Tree.map(items, (item) => item.id)
    )
  )
}