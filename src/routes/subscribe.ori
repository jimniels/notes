(site) => <templates/Page.ori.html>({
  site,
  title: "Subscribe | Jim Nielsen’s Notes",
  path: "/subscribe/",
  head: `<style>
  main ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    list-style-type: none;
    padding: 0;
    margin: 0;
    gap: 0.5rem;
  }
  </style>`,
  children: `
  <header>
    <h1>Subscribe</h1>
    <p>
      Copy/paste the link to this page in your feed reader for <a href="https://blog.jim-nielsen.com/2021/automatically-discoverable-rss-feeds/">automatic discovery</a>.
    </p>
    <p>
      Or manually copy/paste the <a href="/feed.json">JSON</a> or <a href="/feed.xml">RSS</a> feed links.
    </p>
  </header>

  `
})